# Секреты и локальный конфиг пользователя
.env
.env.*
!.env.example
config.yaml
# Личные строки стоп-листа. В CI тот же текст — секрет FORBIDDEN_EXTRA.
scripts/forbidden.local.txt

# data_dir — каталог данных лаунчера (по умолчанию ./data)
data/
data_dir/
# Примеры контракта лежат в demo/data и должны быть в git.
!demo/data/
!demo/data/**
# Демо-наборы пульта: config.yaml и их data/ тоже в git. Пользовательский config.yaml выше остаётся скрытым.
!demo/sets/**/config.yaml
!demo/sets/**/data/
!demo/sets/**/data/**

# Зависимости и сборка
node_modules/
dist/
dist-types/
*.tsbuildinfo

# Логи и мусор ОС
*.log
.DS_Store
Thumbs.db

# Сборка окна Tauri и sidecar. Иконка apps/desktop/icons/app.ico в git остаётся.
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/sea/
apps/desktop/src-tauri/binaries/*
!apps/desktop/src-tauri/binaries/.gitkeep

# Покрытие тестов и прогон браузера
coverage/
test-results/
playwright-report/
blob-report/
ms-playwright/
