# Скопируйте в .env. Сам .env в git не попадает.
# Токены и ключи живут только здесь, не в config.yaml и не во фронте.
# Каркас читает PORT и не печатает значения. Полная проверка .env — PR 3.

# Токен GitHub только для чтения. Пусто — вкладка Git не стартует (это PR 8).
GITHUB_TOKEN=

# Порт loopback-сервера. Адрес всегда 127.0.0.1, переменная HOST его не меняет.
PORT=8787
