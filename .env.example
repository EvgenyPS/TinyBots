# Скопируйте в .env. Сам .env в git не попадает.
# Токены и ключи живут только здесь, не в config.yaml и не во фронте.
# Каркас читает PORT и не печатает значения. Полная проверка .env — PR 3.

# Токен GitHub только для чтения. Пусто — вкладка Git не стартует.
# Права записи (repo, workflow и соседние) тоже не стартуют вкладку.
# Классический токен после проверки прав открывает вкладку Git для публичных репозиториев.
# Fine-grained без нужных полей вкладку не стартует.
# Необязательно: GITHUB_API_BASE, если API не https://api.github.com.
GITHUB_TOKEN=

# Ключи своих ботов. В config.yaml только имя переменной (суффикс _API_KEY), значение — здесь.
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Порт loopback-сервера. Адрес всегда 127.0.0.1, переменная HOST его не меняет.
PORT=8787
